# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/starwars
# How long to wait for MongoDB at boot before giving up (ms, min 100).
MONGODB_CONNECT_TIMEOUT_MS=5000
# If MongoDB is unreachable at boot, start anyway on VOLATILE in-memory data (a bundled
# snapshot of the SWAPI films; every write is lost on restart). /health then reports
# "degraded". Set to false in production to fail fast instead.
DB_FALLBACK_ENABLED=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED, min 16 chars. There is no default: the app refuses to start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1h

# First administrator, created by the seed script (`npm run seed`, or
# `node dist/seed` in production). Both or none. An existing account is never modified.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!123

# ── SWAPI sync ───────────────────────────────────────────────────────────────
SWAPI_BASE_URL=https://www.swapi.tech/api
# Transient failures (network, timeout, 429, 5xx) are retried with exponential backoff:
# delay, 2x delay, 4x delay… Total attempts includes the first one.
SWAPI_RETRY_ATTEMPTS=3
SWAPI_RETRY_DELAY_MS=500
# Cron expression for the scheduled sync (default: every day at 03:00)
SYNC_CRON=0 3 * * *
# Set to false to disable the scheduled sync (the endpoint keeps working).
# Also use it on every replica but one when running several instances.
SYNC_CRON_ENABLED=true
